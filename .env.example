# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง
DATABASE_URL=postgresql://postgres:password@localhost:5432/gymlog
# ยาวอย่างน้อย 32 ตัวอักษร: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000
# NODE_ENV=production   # เปิดเมื่อขึ้นเซิร์ฟเวอร์จริงผ่าน HTTPS
# CORS_ORIGIN=          # ปล่อยว่าง = ใช้โดเมนเดียวกันเท่านั้น
